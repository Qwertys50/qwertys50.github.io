        "kb_layout": "us",
        "sys_enc": "UTF-8",
        "sys_lang": "en_US.UTF-8"
    },
    "network_config": { "type": "nm" },
    "ntp": true,
    "profile_config": null,
    "swap": true,
    "timezone": "Europe/Moscow"
}
