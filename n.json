{
    "archinstall-language": "Russian",
    "audio_config": null,
    "bootloader": "grub",
    "debug": false,
    "disk_config": {
        "config_type": "default_layout",
        "device_modifications": [
            {
                "device": "/dev/sda",
                "wipe": true
            }
        ]
    },
    "hostname": "arch-vm",
